rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function email() {
      return request.auth.token.email;
    }
    function participants(data) {
      return ('Participants' in data) ? data.Participants : [];
    }
    function isAdmin() {
      return isSignedIn() && email() == 'tanguy.brouassin@gmail.com';
    }

    match /users/{userEmail} {
      allow read: if true;

      // Chacun ne peut modifier que son propre Solde (jamais Nom/MTC/Points),
      // dans un sens ou l'autre, borné à 5 (prix max d'un event) par mouvement.
      allow update: if isSignedIn()
                    && email() == userEmail
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Solde'])
                    && request.resource.data.Solde is number
                    && request.resource.data.Solde >= 0
                    && (request.resource.data.Solde - resource.data.Solde) <= 5
                    && (resource.data.Solde - request.resource.data.Solde) <= 5;

      allow create, delete: if false; // reste : Console Firestore uniquement
    }

    match /events/{eventId} {
      allow read: if true;

      // L'admin peut tout créer/modifier/supprimer depuis la page /admin du site.
      allow create, delete: if isAdmin();

      // Mise à jour : soit l'admin (tout champ, ex: marquer les Gagnants),
      // soit n'importe quel joueur connecté mais uniquement pour s'ajouter
      // ou se retirer lui-même de Participants (rien d'autre).
      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Participants'])
                      && (
                        (!(email() in participants(resource.data))
                          && email() in participants(request.resource.data)
                          && participants(request.resource.data).size() == participants(resource.data).size() + 1)
                        ||
                        (email() in participants(resource.data)
                          && !(email() in participants(request.resource.data))
                          && participants(request.resource.data).size() == participants(resource.data).size() - 1)
                      )
                    );
    }

    match /shop/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if false; // Console Firestore uniquement (ouverture/clôture de saison)

      match /classement/{userEmail} {
        allow read: if true;
        allow write: if false; // photo figée, écrite une fois à la clôture de saison
      }
    }
  }
}
